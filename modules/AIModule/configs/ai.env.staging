# =============================================================================
# AI Module Configuration — Production Ready Development
# This file contains actual values for production-ready development
# DO NOT COMMIT to GitHub (.gitignore)
# =============================================================================

# Application
PYTHONUNBUFFERED=1
AI_SERVICE_PORT=8001

# Global Contract Configuration (source of truth: .context/data_schema.yaml -> global_configs.vector_dim)
# WARNING: Changing this value requires CLIP_MODEL_NAME to actually output a
# matching embedding size (512 for ViT-B/32, 768 for ViT-L/14) AND requires
# AG-02 to drop/rebuild the pgvector column/index (images.embedding, idx_images_embedding_hnsw).
VECTOR_DIM=512

# CLIP Model Configuration
CLIP_MODEL_NAME=ViT-B/32
CLIP_PRETRAINED_TAG=openai
DEVICE=auto
MODEL_CACHE_DIR=./models

# Logging
LOG_LEVEL=INFO

# Warm-up Configuration
WARMUP_ITERATIONS=5
WARMUP_TIMEOUT_SEC=30

# Image Embedding Configuration
IMAGE_TARGET_SIZE=224
IMAGE_ENABLE_CACHE=False

# Text Embedding Configuration
TEXT_MAX_TOKENS=77
TEXT_TOKENIZER_NAME=clip
TEXT_ENABLE_CACHE=False
TEXT_TRUNCATE_STRATEGY=truncate

# Batch Embedding Configuration
BATCH_MAX_SIZE=32
BATCH_ENABLE_CACHE=False
BATCH_CACHE_TTL_SECONDS=3600
BATCH_TIMEOUT_MS=10000

# Performance
BATCH_SIZE=32
MAX_WORKERS=4

# Debugging
DEBUG=False