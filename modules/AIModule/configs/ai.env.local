# =============================================================================
# AI Module Configuration — Local Development
# This file contains actual values for local testing
# DO NOT COMMIT to GitHub (.gitignore)
# =============================================================================

# Application
PYTHONUNBUFFERED=1
AI_SERVICE_PORT=8001

# CLIP Model Configuration
CLIP_MODEL_NAME=ViT-B/32
DEVICE=auto
MODEL_CACHE_DIR=./models

# Logging
LOG_LEVEL=INFO

# Warm-up Configuration
WARMUP_ITERATIONS=5
WARMUP_TIMEOUT_SEC=30

# Performance
BATCH_SIZE=32
MAX_WORKERS=4

# Debugging
DEBUG=False
