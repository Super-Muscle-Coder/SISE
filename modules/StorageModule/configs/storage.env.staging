# ===========================
# StorageModule - Environment Configuration (Staging - Use for production only, do not public this to Docker, Dockerhub and Github)
# ===========================

# ===========================
# Docker Compose - PostgreSQL Configuration
# ===========================
POSTGRES_USER=SISE_POSTGRES_ADMIN
POSTGRES_PASSWORD=Daucatmoi123@
POSTGRES_DB=sise

# ===========================
# Docker Compose - MinIO Configuration
# ===========================
MINIO_ACCESS_KEY=SISE_MINIO_ADMIN
MINIO_SECRET_KEY=Daucatmoi123@

# ===========================
# Connection URLs (for application layer)
# ===========================
DATABASE_URL=postgresql+psycopg://SISE_POSTGRES_ADMIN:Daucatmoi123@postgres:5432/siseMINIO_ENDPOINT=http://localhost:9000
REDIS_URL=redis://localhost:6379

# ===========================
# Schema Workflow Configuration
# ===========================
SCHEMA_MIGRATION_TOOL=alembic
SCHEMA_TARGET_REVISION=head
SCHEMA_DOWNGRADE_REVISION=base
SCHEMA_EXTENSIONS=uuid-ossp,pgcrypto,vector

# ===========================
# pgvector-index Workflow Configuration
# (data_schema.yaml -> database_spec.pgvector)
# ===========================
PGVECTOR_VECTOR_DIM=512
PGVECTOR_INDEX_NAME=idx_images_embedding_hnsw
PGVECTOR_INDEX_M=16
PGVECTOR_INDEX_EF_CONSTRUCTION=200
PGVECTOR_OPERATOR_CLASS=vector_cosine_ops
PGVECTOR_SEARCH_EF=64

# ===========================
# Bucket Workflow Configuration
# ===========================
BUCKET_RAW_IMAGES=raw-images
BUCKET_THUMBNAILS=thumbnails
BUCKET_STORAGE_POLICY=private
BUCKET_THUMBNAILS_RULE=expire
BUCKET_THUMBNAILS_DAYS=365
BUCKET_RAW_IMAGES_RULE=archive
BUCKET_RAW_IMAGES_DAYS=3650

# ===========================
# Seed Workflow Configuration
# ===========================
SEED_USER_COUNT=5
SEED_ALBUM_COUNT=10
SEED_IMAGE_COUNT=50