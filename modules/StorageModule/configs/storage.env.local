COLLECTION_METRIC_TYPE=COSINE
COLLECTION_INDEX_TYPE=HNSW
COLLECTION_INDEX_M=16
COLLECTION_INDEX_EF_CONSTRUCTION=200
COLLECTION_SEARCH_EF=64

# bucket workflow config
