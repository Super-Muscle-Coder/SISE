# =============================================================================
# StorageModule — .dockerignore
# =============================================================================
# Reduce Docker build context and prevent secrets from entering image
# =============================================================================

# ── Secrets & Environment Files ──────────────────────────────────────────────
configs/
.env
.env.local
.env.staging
*.pem
*.key
*.crt

# ── Development & Testing ───────────────────────────────────────────────────
tests/
test_*.py
*_test.py
pytest.ini
.pytest_cache/
.coverage
.coveragerc
htmlcov/

# ── Python Cache & Build ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual Environments ────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/

# ── IDE & Version Control ───────────────────────────────────────────────────
.git/
.gitignore
.github/
.vscode/
.idea/
*.pyproj
*.sln
.vs/
*.swp
*.swo
*~

# ── Documentation & Logs ───────────────────────────────────────────────────
documents/
*.log
*.tmp
README.md
CHANGELOG.md

# ── Scripts (Windows-specific, don't need in Linux container) ──────────────
scripts/
*.cmd
*.ps1
*.bat
Makefile
makefile

# ── OS-specific ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.exe
