{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [ "ES2020", "DOM", "DOM.Iterable" ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [ "vite/client" ],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [ "./src/*" ],
      "@/utils/*": [ "./utils/*" ],
      "*": [ "./*" ]
    }
  },
  "include": [ "src" ]
}