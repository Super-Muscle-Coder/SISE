# ============================================================================
# SISE FrontendWeb (AG-04) — Local Development Environment
# Version: v1.2.3 (khớp openapi.yaml/data_schema.yaml hiện hành)
# SỬA QUAN TRỌNG: file này TRƯỚC ĐÂY đặt sai tên (frontendweb.env.local)
# VÀ sai thư mục (configs/) — Vite CHỈ tự động nạp file tên đúng
# .env/.env.local/.env.[mode]/.env.[mode].local, đặt TẠI THƯ MỤC GỐC
# (cùng cấp package.json, vite.config.ts — không có envDir tùy chỉnh trong
# vite.config.ts). Mọi giá trị "đã sửa" trước đây trong file cũ CHƯA TỪNG
# được Vite đọc — toàn bộ app chạy bằng giá trị fallback hardcode trong
# code (getEnvXxxWithDefault(key, fallback)). File này PHẢI nằm đúng tại
# modules/FrontendWeb/.env.local (KHÔNG phải modules/FrontendWeb/configs/).
#
# Nguyên tắc annotation:
#   [CONTRACT]  = giá trị lấy trực tiếp từ global_configs/schema hợp đồng,
#                 PHẢI khớp chính xác con số bên data_schema.yaml/openapi.yaml.
#                 Sai giá trị này = vi phạm hợp đồng, không phải tùy chỉnh UX.
#   [UI-ONLY]   = quy ước riêng của Frontend, KHÔNG có trong hợp đồng nào.
#                 Được phép tồn tại vì phục vụ UX, nhưng thay đổi tự do,
#                 không cần đồng bộ với Backend.
#   [BENCHMARK-TUNED] = giá trị [UI-ONLY] đã ĐIỀU CHỈNH TẠM THỜI để phục vụ
#                 giai đoạn thu thập dữ liệu/benchmark quy mô lớn (~500-1000
#                 ảnh, 10-15 danh mục, tối đa 50 ảnh/danh mục). Không phải
#                 giá trị production cuối cùng — cân nhắc hạ lại nếu deploy
#                 thật với dữ liệu quy mô khác.
# ============================================================================

# ============================================================================
# [CONTRACT] API Gateway — trỏ tới BackendModule (AG-03), Clause D
# ============================================================================
VITE_API_BASE_URL=http://localhost:8000

# [CONTRACT] data_schema.yaml global_configs.default_timeout_ms
VITE_API_TIMEOUT_MS=10000

# ============================================================================
# [CONTRACT] Health & Readiness — openapi.yaml /health/readiness,
# data_schema.yaml observability.health_probes
# ============================================================================
VITE_HEALTH_CHECK_INTERVAL_MS=30000

# ============================================================================
# [CONTRACT] Retry Policy — data_schema.yaml global_configs.retry_policy
# ============================================================================
VITE_RETRY_MAX_ATTEMPTS=3
VITE_RETRY_BACKOFF_MS=1000
VITE_RETRY_BACKOFF_FACTOR=2

# ============================================================================
# [CONTRACT] Idempotency — data_schema.yaml global_configs.idempotency_ttl_hours
# ============================================================================
VITE_IDEMPOTENCY_TTL_HOURS=24

# ============================================================================
# [CONTRACT] Presigned Upload — data_schema.yaml global_configs + storage.presigned
# ============================================================================
VITE_PRESIGNED_URL_EXPIRY_SEC=3600
VITE_MAX_FILE_SIZE_MB=20
VITE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png

# ============================================================================
# [CONTRACT] Vector Embedding — data_schema.yaml global_configs.vector_dim
# ============================================================================
VITE_DEFAULT_VECTOR_DIM=512
VITE_SUPPORTED_VECTOR_DIMS=512,768

# ============================================================================
# [CONTRACT] Metric Type — openapi.yaml components.schemas.MetricType
# ============================================================================
VITE_SEARCH_METRIC=COSINE

# ============================================================================
# AUTH — openapi.yaml AuthRequest/AuthResponse/User
# ============================================================================
VITE_AUTH_STORAGE_TOKEN_KEY=sise_auth_token
VITE_AUTH_STORAGE_USER_KEY=sise_user_profile
VITE_AUTH_SESSION_STARTED_EVENT=sise:sessionStarted
VITE_AUTH_SESSION_EXPIRED_EVENT=sise:sessionExpired
VITE_AUTH_SESSION_ENDED_EVENT=sise:sessionEnded
VITE_AUTH_EMAIL_PATTERN=^[^\s@]+@[^\s@]+\.[^\s@]+$
VITE_AUTH_USERNAME_MIN_LENGTH=3
VITE_AUTH_USERNAME_MAX_LENGTH=50
VITE_AUTH_PASSWORD_MIN_LENGTH=8
VITE_AUTH_PASSWORD_MAX_LENGTH=128

# ============================================================================
# MEDIA WORKFLOW (T004-03) — openapi.yaml /albums, /media/*
# ============================================================================
# [BENCHMARK-TUNED] Trước: 20 (default hợp đồng) → từng thử 300 nhưng
# BACKEND TỪ CHỐI với 422 "Input should be less than or equal to 100" —
# phát hiện quan trọng: Backend có ràng buộc CỨNG limit<=100 (Pydantic
# Query(le=100)) mà openapi.yaml KHÔNG hề ghi nhận (chỉ khai
# {type: integer, default: 20}, không có "maximum"). Đây là thiếu sót tài
# liệu hợp đồng, không phải bug — nhưng Frontend BẮT BUỘC tuân theo giới
# hạn thật của Backend, không thể vượt qua bằng bất kỳ cách nào từ client.
# Giữ đúng 100 (trần tối đa Backend cho phép) — đủ cho từng album lẻ (tối
# đa 50 ảnh/người theo kế hoạch), KHÔNG đủ để xem toàn bộ ~750 ảnh không
# lọc album trong 1 lần tải — nếu cần xem hết, phải tự phân trang nhiều
# lần (offset tăng dần) chứ không thể tăng limit vượt 100.
VITE_MEDIA_LIST_DEFAULT_LIMIT=100
VITE_MEDIA_LIST_DEFAULT_OFFSET=0

# [UI-ONLY] Polling trạng thái index_status sau khi upload.
VITE_MEDIA_INDEX_STATUS_POLL_INTERVAL_MS=3000
VITE_MEDIA_MAX_POLL_RETRIES=10

# [BENCHMARK-TUNED] Bulk upload — trước: concurrent=3, retries=2, batch=20.
# Giờ tăng để đỡ phải kéo-thả nhiều lần khi upload tới 750 ảnh, và tận
# dụng máy cục bộ mạnh hơn server production thật.
VITE_MEDIA_BULK_MAX_CONCURRENT_UPLOADS=5
VITE_MEDIA_BULK_MAX_RETRIES=2
VITE_MEDIA_BULK_MAX_FILES_PER_BATCH=50

# ============================================================================
# SEARCH WORKFLOW (T004-05) — openapi.yaml /search/image, /search/text
# ============================================================================
VITE_SEARCH_DEBOUNCE_MS=500

# [BENCHMARK-TUNED] Trước: 10 (default hợp đồng đúng, KHÔNG SAI, chỉ là
# giá trị mặc định Backend dùng khi Frontend không gửi top_k). Giờ tăng
# lên 40 — với tối đa 50 ảnh/danh mục thật trong DB, top_k=40 đủ để thấy
# gần hết ảnh liên quan thật + vùng "rơi điểm" khi bắt đầu lẫn sang danh
# mục khác (đúng dữ liệu cần để tính Recall@K/HitRate@K có ý nghĩa thống
# kê) — KHÔNG đẩy lên quá cao (vd 100+) vì sẽ làm loãng chỉ số: nếu K gần
# bằng hoặc vượt tổng số ảnh trong DB, hầu hết truy vấn đều "hit" chỉ vì K
# đủ lớn, chỉ số mất khả năng phân biệt mô hình tốt/xấu.
VITE_SEARCH_DEFAULT_TOP_K=40

VITE_SEARCH_SCORE_THRESHOLD_HIGH=0.85
VITE_SEARCH_SCORE_THRESHOLD_MEDIUM=0.65
VITE_SEARCH_REQUEST_TIMEOUT_MS=30000
VITE_SEARCH_MAX_IMAGE_SIZE_MB=20

# ============================================================================
# EVALUATION WORKFLOW (T003-07, admin only) — openapi.yaml /eval/*
# ============================================================================
# [BENCHMARK-TUNED][CẢNH BÁO] Trước: 500 (đã test thật, hoạt động đúng
# với dataset 500-700 ảnh). Tăng lên 1200 để chạy HẾT toàn bộ dữ liệu khi
# dataset đạt tới kế hoạch 1000 ảnh/20 đối tượng (dư ra 200 để không phải
# sửa lại lần nữa nếu upload thêm chút ít sau này). LƯU Ý: limit chỉ giới
# hạn SỐ LƯỢNG ẢNH ĐƯỢC CHỌN LÀM QUERY — tập dữ liệu để SO SÁNH (tính
# rank/score) LUÔN LÀ TOÀN BỘ database, không bị giới hạn bởi limit này
# (đã xác nhận với AG-03). Nếu tổng số ảnh trong DB < limit, Backend sẽ tự
# lấy tối đa số ảnh THẬT SỰ có (đã quan sát: 700 ảnh nhưng limit=500 vẫn
# chỉ query đúng "min(limit, tổng_ảnh_thật)"). VẪN CẦN TỰ TEST lại nếu
# server báo 422 do ràng buộc "le" ẩn tương tự bài học ở /media,/albums.
VITE_EVAL_RUN_DEFAULT_LIMIT=1200

# [BENCHMARK-TUNED] Timeout RIÊNG cho POST /eval/run — phát hiện qua test
# thật: endpoint chạy ĐỒNG BỘ, thời gian xử lý tỷ lệ thuận với số lượng
# query (limit). Trước: 300000ms (5 phút, đủ cho limit=500). Tăng lên
# 600000ms (10 phút) khi limit tăng lên 1200 — mỗi query cần so sánh với
# TOÀN BỘ database (không chỉ trong phạm vi limit), nên tổng thời gian có
# thể tăng nhanh hơn tuyến tính khi cả limit LẪN tổng số ảnh trong DB đều
# tăng. Điều chỉnh cao hơn nữa nếu vẫn timeout với dataset 1000+ ảnh.
VITE_EVAL_RUN_TIMEOUT_MS=600000

# [UI-ONLY] Polling chờ /eval/run hoàn tất — KHÔNG phải retry_policy.
VITE_EVAL_POLL_INTERVAL_MS=3000
# [BENCHMARK-TUNED] Trước: 120000 (2 phút). Với limit=500 ảnh mỗi lần eval
# (thay vì 100), thời gian xử lý sẽ dài hơn đáng kể — tăng timeout chờ để
# tránh bị coi là "timeout" oan khi job vẫn đang chạy bình thường, chỉ là
# chậm hơn vì tập mẫu lớn hơn.
VITE_EVAL_POLL_MAX_DURATION_MS=300000

VITE_EVAL_RUN_BUTTON_LABEL=Run Evaluation
VITE_EVAL_RESET_BUTTON_LABEL=Reset

# ============================================================================
# ADMIN — openapi.yaml POST /admin/reindex
# ============================================================================
# [BENCHMARK-TUNED][CẢNH BÁO] Trước: 100 (default hợp đồng). Tăng lên 300
# CHƯA ĐƯỢC TEST THỰC TẾ — cùng lý do cảnh báo như VITE_EVAL_RUN_DEFAULT_LIMIT
# ở trên. PHẢI TỰ TEST bằng cách bấm reindex thật trước khi tin giá trị
# này chạy được.
VITE_ADMIN_REINDEX_DEFAULT_BATCH_SIZE=300

# ============================================================================
# Feature Flags & Logging — [UI-ONLY], không liên quan hợp đồng
# ============================================================================
VITE_LOG_LEVEL=info
VITE_ENABLE_REQUEST_LOGGING=false
