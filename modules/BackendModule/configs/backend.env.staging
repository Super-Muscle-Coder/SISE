# Backend Service Configuration - STAGING
# Fill secrets from centralized secret manager before deployment.

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=False

# Database (PostgreSQL)
DATABASE_URL=CHANGE_ME_IN_STAGING

# AI Service Integration
AI_SERVICE_URL=http://ai-service:8001

# Object Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_IN_STAGING
MINIO_SECRET_KEY=CHANGE_ME_IN_STAGING
MINIO_BUCKET_IMAGES=images
MINIO_BUCKET_METADATA=metadata

# Cache (Redis)
REDIS_URL=redis://redis:6379/0

# Authentication (JWT)
JWT_SECRET=CHANGE_ME_IN_STAGING
JWT_ALGORITHM=HS256
JWT_EXPIRY_SEC=86400

# Celery (Task Queue)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=4

# Search & Privacy
ENABLE_PRIVACY_FILTER=True

# Presigned URL Configuration (from data_schema.yaml)
PRESIGNED_URL_EXPIRY_SEC=3600

# Observability
LOG_LEVEL=INFO
METRICS_ENABLED=True

# Global Configuration (from data_schema.yaml)
VECTOR_DIM=512

# Evaluation Service Configuration
EVAL_DB_PATH=/app/data/evaluation.db
EVAL_MAX_IMAGES=1000
EVAL_TOP_K=10
EVAL_SEED=42
EVAL_ALLOW_ADMIN_ONLY=True

# Health Check Configuration
HEALTH_CHECK_TIMEOUT_SEC=5
HEALTH_CHECK_RETRY_ATTEMPTS=2
HEALTH_POSTGRES_ENABLED=True
HEALTH_MINIO_ENABLED=True
HEALTH_AI_SERVICE_ENABLED=True
HEALTH_REDIS_ENABLED=True