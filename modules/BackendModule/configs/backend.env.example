# Backend Service Configuration Template
# This file serves as a template for environment variables.
# Do not commit values to this file; use backend.env.local for local development.

# Server Configuration
BACKEND_HOST=
BACKEND_PORT=
DEBUG=

# Database (PostgreSQL)
DATABASE_URL=

# AI Service Integration
AI_SERVICE_URL=

# Object Storage (MinIO)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_IMAGES=
MINIO_BUCKET_METADATA=

# Vector Store (Milvus)
MILVUS_HOST=
MILVUS_PORT=
MILVUS_COLLECTION_IMAGES=

# Cache (Redis)
REDIS_URL=

# Authentication (JWT)
JWT_SECRET=
JWT_ALGORITHM=
JWT_EXPIRY_SEC=

# Celery (Task Queue)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_WORKER_CONCURRENCY=

# Search & Privacy
ENABLE_PRIVACY_FILTER=

# Presigned URL Configuration
PRESIGNED_URL_EXPIRY_SEC=

# Observability
LOG_LEVEL=
METRICS_ENABLED=

# Vector Dimension (from data_schema.yaml)
VECTOR_DIM=

# Evaluation Service Configuration
EVAL_DB_PATH=
EVAL_MAX_IMAGES=
EVAL_TOP_K=
EVAL_SEED=
EVAL_ALLOW_ADMIN_ONLY=

# Health Check Configuration
HEALTH_CHECK_TIMEOUT_SEC=
HEALTH_CHECK_RETRY_ATTEMPTS=
HEALTH_POSTGRES_ENABLED=
HEALTH_MILVUS_ENABLED=
HEALTH_MINIO_ENABLED=
HEALTH_AI_SERVICE_ENABLED=
