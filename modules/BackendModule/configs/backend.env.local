# Backend Service Configuration - LOCAL DEVELOPMENT
# This file contains local development values.
# DO NOT COMMIT THIS FILE to version control.

# Server Configuration
BACKEND_HOST=localhost
BACKEND_PORT=8000
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sise_backend

# AI Service Integration
AI_SERVICE_URL=http://localhost:8001

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_IMAGES=images
MINIO_BUCKET_METADATA=metadata

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# Authentication (JWT)
JWT_SECRET=your-super-secret-key-change-in-production-12345678901234567890
JWT_ALGORITHM=HS256
JWT_EXPIRY_SEC=86400

# Celery (Task Queue)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=4

# Search & Privacy
ENABLE_PRIVACY_FILTER=True

# Presigned URL Configuration (from data_schema.yaml)
PRESIGNED_URL_EXPIRY_SEC=3600

# Observability
LOG_LEVEL=DEBUG
METRICS_ENABLED=True

# Global Configuration (from data_schema.yaml)
VECTOR_DIM=512

# Evaluation Service Configuration
EVAL_DB_PATH=./data/evaluation.db
EVAL_MAX_IMAGES=1000
EVAL_TOP_K=10
EVAL_SEED=42
EVAL_ALLOW_ADMIN_ONLY=True

# Health Check Configuration
HEALTH_CHECK_TIMEOUT_SEC=5
HEALTH_CHECK_RETRY_ATTEMPTS=2
HEALTH_POSTGRES_ENABLED=True
HEALTH_MINIO_ENABLED=True
HEALTH_AI_SERVICE_ENABLED=True
HEALTH_REDIS_ENABLED=True